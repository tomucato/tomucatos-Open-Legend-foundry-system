{{!-- Open Legend Active Effect "Details" tab. Mirrors core, but DROPS the two
      fields this system does not use:
        - Effect Origin  (banes/boons are applied via flags.openlegend, not origin)
        - Status Conditions (this system uses its own condition/effects-panel
          system, not core CONFIG.statusEffects)
      The remaining fields (tint, description, disabled, transfer, show-icon) are
      meaningful and kept. --}}
<section class="tab scrollable{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    {{formGroup fields.tint value=source.tint rootId=rootId placeholder="#ffffff"}}
    {{formGroup fields.description value=source.description rootId=rootId}}
    {{formGroup fields.disabled value=source.disabled rootId=rootId}}

    {{#if isItemEffect}}
    {{formGroup fields.transfer value=source.transfer rootId=rootId}}
    {{/if}}

    {{formGroup fields.showIcon value=source.showIcon options=showIconOptions rootId=rootId}}
</section>
